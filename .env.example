# ========================================
# ตัวอย่างไฟล์ Environment Variables
# ========================================
# วิธีใช้: คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่องของคุณ
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (macOS/Linux)
# ========================================

# Server
PORT=3000
NODE_ENV=development

# Database (MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=watnaku_db

# JWT (Authentication)
# ควรตั้งเป็นข้อความสุ่มยาวๆ และเก็บเป็นความลับ ห้าม commit ไฟล์ .env
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=1d

# Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
